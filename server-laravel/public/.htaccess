# GoDaddy cPanel Laravel Deployment - Reservation API
# ====================================================

# This .htaccess protects the Laravel application when deployed
# on GoDaddy Deluxe Web Hosting with cPanel.

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options +FollowSymLinks

    # Block access to sensitive files
    RewriteRule ^\.env - [F,L]
    RewriteRule ^composer\.json - [F,L]
    RewriteRule ^composer\.lock - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^storage/framework/ - [F,L]
    RewriteRule ^app/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^routes/ - [F,L]

    # Handle Authorization header for JWT
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle OPTIONS preflight requests immediately with 204 No Content
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=204,L]

    # Redirect all requests to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Gzip / Deflate compression for API JSON and text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/plain text/html text/xml text/css application/javascript image/svg+xml
</IfModule>

# Browser Caching & Far-Future Expires for Uploaded Media & Images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Security, CORS & Cache headers
<IfModule mod_headers.c>
    Header append Vary Accept-Encoding
    # Immutable cache headers for all image uploads
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Idempotency-Key, Accept, Origin, Application, Stripe-Signature"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
