# GoDaddy cPanel Laravel Deployment - Reservation API
# ====================================================

# This .htaccess protects the Laravel application when deployed
# on GoDaddy Deluxe Web Hosting with cPanel.

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options +FollowSymLinks

    # Block access to sensitive files
    RewriteRule ^\.env - [F,L]
    RewriteRule ^composer\.json - [F,L]
    RewriteRule ^composer\.lock - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^storage/framework/ - [F,L]
    RewriteRule ^app/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^routes/ - [F,L]

    # Handle Authorization header for JWT
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle OPTIONS preflight requests immediately with 204 No Content
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=204,L]

    # Redirect all requests to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Security & CORS headers (guarantees CORS headers even on 500/errors)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Idempotency-Key, Accept, Origin, Application, Stripe-Signature"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
