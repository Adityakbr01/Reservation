APP_NAME="Reservation API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laravel.hamptworthstays.com

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
MEDIA_DISK=public
STORAGE_PROVIDER=local
ASSETS_BASE_URL=

FRONTEND_URL=https://hamptworthstays.com
ADMIN_URL=https://admin.hamptworthstays.com
CLIENT_URL=https://hamptworthstays.com
ALLOWED_ORIGINS=https://hamptworthstays.com,https://www.hamptworthstays.com,https://admin.hamptworthstays.com

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@hamptworthstays.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Resend (email) ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="no-reply@hamptworthstays.com"
EMAIL_FROM=no-reply@hamptworthstays.com
EMAIL_REPLY_TO=no-reply@hamptworthstays.com
ADMIN_NOTIFICATION_EMAIL=
EMAIL_LOGO_URL=

GODADDY_FTP_HOST=
GODADDY_FTP_PORT=21
GODADDY_FTP_USER=
GODADDY_FTP_PASSWORD=
GODADDY_FTP_SECURE=true
GODADDY_FTP_PREFIX=
