# Copy to .env and fill in. Never commit .env with real secrets.
NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/reservation

# Reserved for a future shared-cache backend (see src/config/cache.ts).
# The foundation uses in-process Node-Cache and does not read this yet.
NODE_CACHE_URL=

JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

CACHE_TTL_SECONDS=900
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
