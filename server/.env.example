# Copy to .env and fill in. Never commit .env with real secrets.
NODE_ENV=development
PORT=5000

# MySQL Database connection (Prisma)
DATABASE_URL="mysql://reservation_user:reservation_password@127.0.0.1:3306/reservation"

# Legacy MongoDB URI (used only for historical backup/restore scripts)
MONGODB_URI=mongodb://127.0.0.1:27017/reservation

JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Optional: seed a staff admin at boot (the admin frontend has no registration).
# Uncomment and fill in, then restart the server. Existing accounts are never
# modified — seeding only creates the admin when the email is not registered.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please-8-chars-min

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

CACHE_TTL_SECONDS=900
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=
# Optional absolute https logo for the email header (e.g. a hosted logo.webp).
# Relative paths never render in inboxes; unset keeps the text lockup.
# EMAIL_LOGO_URL=https://book.hamptworthstays.com/logo.webp

# Binary asset storage: GoDaddy FTP uploads. Never commit real secrets.
STORAGE_PROVIDER=ftp
GODADDY_FTP_HOST=
GODADDY_FTP_PORT=21
GODADDY_FTP_USER=
GODADDY_FTP_PASSWORD=
GODADDY_FTP_SECURE=true
# Set when the FTP cert name differs from GODADDY_FTP_HOST (GoDaddy shared
# certs use *.prod.<region>.secureserver.net).
GODADDY_FTP_TLS_SERVERNAME=
GODADDY_FTP_PREFIX=
# Base = public URL of the FTP jail root (point the FTP account directory at the
# domain-root uploads/ folder in cPanel; keys carry no prefix).
ASSETS_BASE_URL=https://hamptworthstays.com/uploads
