generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Property {
  id           String   @id @db.Char(24)
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(140)
  description  String?  @db.Text
  contact      Json?
  mapEmbedUrl  String?  @db.VarChar(1000)
  checkInTime  String   @default("14:00") @db.VarChar(10)
  checkOutTime String   @default("12:00") @db.VarChar(10)
  timezone     String   @default("Asia/Kolkata") @db.VarChar(60)
  currency     String   @default("INR") @db.VarChar(10)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  roomTypes            RoomType[]
  rooms                Room[]
  ratePlans            RatePlan[]
  dailyPrices          DailyPrice[]
  cancellationPolicies CancellationPolicy[]
  availabilityBlocks   AvailabilityBlock[]
  coupons              Coupon[]
  bookings             Booking[]

  @@map("properties")
}

model Amenity {
  id           String   @id @db.Char(24)
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(140)
  group        String   @default("HIGHLIGHT") @db.VarChar(30)
  description  String?  @db.Text
  imageMediaId String?  @db.Char(24)
  iconUrl      String?  @db.VarChar(500)
  sortOrder    Int      @default(0)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  @@index([group, status, sortOrder])
  @@map("amenities")
}

model RoomType {
  id                       String   @id @db.Char(24)
  propertyId               String   @db.Char(24)
  name                     String   @db.VarChar(120)
  slug                     String   @db.VarChar(140)
  shortDescription         String?  @db.Text
  description              String?  @db.MediumText
  maxAdults                Int
  maxChildren              Int      @default(0)
  maxOccupancy             Int
  beds                     Json?
  amenities                Json?
  images                   Json?
  media                    Json?
  propertyDetailsHtml      String?  @db.MediumText
  layoutHtml               String?  @db.MediumText
  floorplanMediaIds        Json?
  locationText             String?  @db.Text
  surroundingsHtml         String?  @db.MediumText
  mapLat                   Float?
  mapLng                   Float?
  mapEmbedUrl              String?  @db.Text
  welcomeHamperIncluded    Boolean  @default(false)
  welcomeHamperDescription String?  @db.Text
  welcomeHamperImageMediaId String? @db.Char(24)
  welcomeHamperHtml        String?  @db.MediumText
  amenityIds               Json?
  nearbyAttractions        Json?
  bedrooms                 Int?
  bathrooms                Int?
  maxDogs                  Int?
  dogPolicyEnabled          Boolean?  @default(false)
  dogPolicyTitle            String?   @db.VarChar(160)
  dogPolicySubtitle         String?   @db.VarChar(255)
  dogFee                    Float?    @default(70)
  dogPolicyImageMediaId     String?   @db.Char(24)
  status                   String   @default("DRAFT") @db.VarChar(20)
  seo                      Json?
  createdAt                DateTime @default(now()) @db.DateTime(3)
  updatedAt                DateTime @updatedAt @db.DateTime(3)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  ratePlans    RatePlan[]
  bookingItems BookingItem[]
  reviews      Review[]
  enquiries    Enquiry[]

  @@unique([propertyId, slug])
  @@index([propertyId, status])
  @@map("roomtypes")
}

model Room {
  id         String   @id @db.Char(24)
  propertyId String   @db.Char(24)
  roomTypeId String   @db.Char(24)
  name       String   @db.VarChar(80)
  roomNumber String   @db.VarChar(20)
  floor      String?  @db.VarChar(20)
  status     String   @default("ACTIVE") @db.VarChar(20)
  condition  String?  @db.VarChar(1000)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  availabilityBlocks AvailabilityBlock[]
  bookingItems       BookingItem[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, roomTypeId, status])
  @@map("rooms")
}

model RatePlan {
  id                   String   @id @db.Char(24)
  propertyId           String   @db.Char(24)
  roomTypeId           String   @db.Char(24)
  name                 String   @db.VarChar(120)
  slug                 String   @db.VarChar(140)
  description          String?  @db.Text
  pricing              Json
  restrictions         Json
  cancellationPolicyId String?  @db.Char(24)
  status               String   @default("DRAFT") @db.VarChar(20)
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)

  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  dailyPrices        DailyPrice[]
  bookingItems       BookingItem[]

  @@unique([propertyId, slug])
  @@index([propertyId, roomTypeId, status])
  @@map("rateplans")
}

model DailyPrice {
  id         String   @id @default(cuid()) @db.VarChar(36)
  ratePlanId String   @db.Char(24)
  propertyId String   @db.Char(24)
  date       DateTime @db.Date
  price      Int
  currency   String   @default("GBP") @db.VarChar(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
  @@index([propertyId, date])
  @@map("dailyprices")
}

model CancellationPolicy {
  id                    String   @id @db.Char(24)
  propertyId            String   @db.Char(24)
  name                  String   @db.VarChar(120)
  freeCancellationHours Int
  refundPercentage      Decimal  @db.Decimal(5, 2)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now()) @db.DateTime(3)
  updatedAt             DateTime @updatedAt @db.DateTime(3)

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlans RatePlan[]

  @@index([propertyId, isDefault])
  @@map("cancellationpolicies")
}

model AvailabilityBlock {
  id         String   @id @db.Char(24)
  propertyId String   @db.Char(24)
  roomId     String   @db.Char(24)
  startDate  DateTime @db.DateTime(3)
  endDate    DateTime @db.DateTime(3)
  reason     String?  @db.VarChar(300)
  createdBy  String?  @db.Char(24)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([roomId, startDate, endDate])
  @@index([propertyId, startDate, endDate])
  @@map("availabilityblocks")
}

model Coupon {
  id                    String    @id @db.Char(24)
  propertyId            String    @db.Char(24)
  code                  String    @db.VarChar(40)
  normalizedCode        String    @db.VarChar(40)
  discountType          String    @db.VarChar(20)
  discountValue         Decimal   @db.Decimal(12, 2)
  maxDiscount           Decimal?  @db.Decimal(12, 2)
  minimumBookingAmount  Decimal?  @db.Decimal(12, 2)
  validFrom             DateTime? @db.DateTime(3)
  validUntil            DateTime? @db.DateTime(3)
  usageLimit            Int?
  usageCount            Int       @default(0)
  perUserLimit          Int?
  applicableRoomTypeIds Json?
  status                String    @default("ACTIVE") @db.VarChar(20)
  createdBy             String?   @db.Char(24)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([propertyId, normalizedCode])
  @@index([propertyId, status, validFrom, validUntil])
  @@map("coupons")
}

model User {
  id                     String    @id @db.Char(24)
  name                   String    @db.VarChar(80)
  email                  String    @unique @db.VarChar(160)
  passwordHash           String    @db.VarChar(255)
  role                   String    @default("user") @db.VarChar(30)
  isActive               Boolean   @default(true)
  avatarUrl              String?   @db.VarChar(500)
  avatarFileId           String?   @db.VarChar(255)
  avatarStorageProvider  String    @default("ftp") @db.VarChar(20)
  legacyAvatarUrl        String?   @db.VarChar(500)
  legacyAvatarFileId     String?   @db.VarChar(255)
  passwordResetTokenHash String?   @db.VarChar(255)
  passwordResetExpires   DateTime? @db.DateTime(3)
  lastLoginAt            DateTime? @db.DateTime(3)
  createdAt              DateTime  @default(now()) @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @db.DateTime(3)

  bookings           Booking[]
  payments           Payment[]
  refunds            Refund[]
  createdBlocks      AvailabilityBlock[]
  createdCoupons     Coupon[]
  createdMedia       Media[]
  reviews            Review[]
  emailTemplates     EmailTemplate[]
  createdPages       CmsPage[]
  createdBlogPosts   CmsBlogPost[]
  createdFaqs        CmsFaq[]
  createdOffers      CmsOffer[]
  createdPolicyDocs  CmsPolicyDoc[]

  @@index([passwordResetTokenHash])
  @@map("users")
}

model Booking {
  id            String   @id @db.Char(24)
  bookingNumber String   @unique @db.VarChar(32)
  propertyId    String   @db.Char(24)
  userId        String?  @db.Char(24)
  status        String   @default("HELD") @db.VarChar(20)
  paymentStatus String   @default("PENDING") @db.VarChar(20)
  checkIn       DateTime @db.DateTime(3)
  checkOut      DateTime @db.DateTime(3)
  guests        Json
  contact       Json
  pricing       Json
  cancellation  Json?
  hold          Json?
  stay          Json?
  source        String   @default("DIRECT") @db.VarChar(20)
  notes         String?  @db.Text
  reminderSent  Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  payments      Payment[]
  refunds       Refund[]
  notifications Notification[]
  reviews       Review[]

  @@index([propertyId, status, checkIn])
  @@index([propertyId, checkOut])
  @@index([status, reminderSent, checkIn])
  @@index([userId, createdAt])
  @@map("bookings")
}

model BookingItem {
  id                   String    @id @db.Char(24)
  bookingId            String    @db.Char(24)
  roomTypeId           String?   @db.Char(24)
  roomId               String?   @db.Char(24)
  ratePlanId           String?   @db.Char(24)
  roomNameSnapshot     String    @db.VarChar(120)
  roomNumberSnapshot   String?   @db.VarChar(20)
  ratePlanNameSnapshot String    @db.VarChar(120)
  checkIn              DateTime  @db.DateTime(3)
  checkOut             DateTime  @db.DateTime(3)
  guests               Json
  pricing              Json
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @db.DateTime(3)

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([roomId, checkIn, checkOut])
  @@map("bookingitems")
}

model Payment {
  id                        String    @id @db.Char(24)
  bookingId                 String    @db.Char(24)
  userId                    String?   @db.Char(24)
  provider                  String    @default("STRIPE") @db.VarChar(20)
  providerPaymentIntentId   String?   @unique @db.VarChar(120)
  providerCheckoutSessionId String?   @db.VarChar(120)
  amount                    Decimal   @db.Decimal(12, 2)
  currency                  String    @db.VarChar(10)
  status                    String    @default("PENDING") @db.VarChar(20)
  failureCode               String?   @db.VarChar(100)
  failureMessage            String?   @db.Text
  paidAt                    DateTime? @db.DateTime(3)
  metadata                  Json?
  createdAt                 DateTime  @default(now()) @db.DateTime(3)
  updatedAt                 DateTime  @updatedAt @db.DateTime(3)

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  refunds       Refund[]
  notifications Notification[]

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

model Refund {
  id               String    @id @db.Char(24)
  bookingId        String    @db.Char(24)
  paymentId        String    @db.Char(24)
  provider         String    @default("STRIPE") @db.VarChar(20)
  providerRefundId String    @unique @db.VarChar(120)
  amount           Decimal   @db.Decimal(12, 2)
  currency         String    @db.VarChar(10)
  status           String    @default("SUCCEEDED") @db.VarChar(20)
  reason           String?   @db.Text
  requestedBy      String?   @db.Char(24)
  processedAt      DateTime? @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requester User?   @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([paymentId])
  @@map("refunds")
}

model WebhookEvent {
  id               String    @id @default(cuid()) @db.VarChar(36)
  provider         String    @default("STRIPE") @db.VarChar(20)
  stripeEventId    String    @unique @db.VarChar(120)
  eventType        String    @db.VarChar(100)
  receivedAt       DateTime  @default(now()) @db.DateTime(3)
  processedAt      DateTime? @db.DateTime(3)
  processingStatus String    @default("RECEIVED") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  @@map("webhookevents")
}

model CmsPage {
  id                   String    @id @db.Char(24)
  title                String    @db.VarChar(160)
  slug                 String    @unique @db.VarChar(140)
  excerpt              String?   @db.VarChar(300)
  sections             Json
  featuredImageMediaId String?   @db.Char(24)
  seo                  Json?
  status               String    @default("DRAFT") @db.VarChar(20)
  version              Int       @default(1)
  publishedAt          DateTime? @db.DateTime(3)
  createdBy            String?   @db.Char(24)
  previewToken         String?   @db.VarChar(100)
  previewExpiresAt     DateTime? @db.DateTime(3)
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @db.DateTime(3)

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, slug])
  @@index([previewToken])
  @@map("cmspages")
}

model CmsBlogPost {
  id                   String    @id @db.Char(24)
  title                String    @db.VarChar(160)
  slug                 String    @unique @db.VarChar(140)
  excerpt              String?   @db.VarChar(300)
  content              String    @db.LongText
  featuredImageMediaId String?   @db.Char(24)
  author               String?   @db.VarChar(120)
  category             String?   @db.VarChar(80)
  tags                 Json?
  readingMinutes       Int       @default(1)
  seo                  Json?
  status               String    @default("DRAFT") @db.VarChar(20)
  version              Int       @default(1)
  publishedAt          DateTime? @db.DateTime(3)
  createdBy            String?   @db.Char(24)
  previewToken         String?   @db.VarChar(100)
  previewExpiresAt     DateTime? @db.DateTime(3)
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @db.DateTime(3)

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, slug])
  @@index([status, category, createdAt])
  @@index([previewToken])
  @@map("cmsblogposts")
}

model CmsFaq {
  id               String    @id @db.Char(24)
  question         String    @db.VarChar(300)
  answer           String    @db.MediumText
  category         String?   @db.VarChar(80)
  sortOrder        Int       @default(0)
  status           String    @default("DRAFT") @db.VarChar(20)
  version          Int       @default(1)
  publishedAt      DateTime? @db.DateTime(3)
  createdBy        String?   @db.Char(24)
  previewToken     String?   @db.VarChar(100)
  previewExpiresAt DateTime? @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, category, sortOrder])
  @@index([previewToken])
  @@map("cmsfaqs")
}

model CmsOffer {
  id               String    @id @db.Char(24)
  title            String    @db.VarChar(160)
  slug             String    @unique @db.VarChar(140)
  description      String    @db.MediumText
  imageMediaId     String?   @db.Char(24)
  validFrom        DateTime? @db.DateTime(3)
  validUntil       DateTime? @db.DateTime(3)
  ctaLabel         String?   @db.VarChar(80)
  ctaUrl           String?   @db.VarChar(500)
  couponId         String?   @db.Char(24)
  seo              Json?
  status           String    @default("DRAFT") @db.VarChar(20)
  version          Int       @default(1)
  publishedAt      DateTime? @db.DateTime(3)
  createdBy        String?   @db.Char(24)
  previewToken     String?   @db.VarChar(100)
  previewExpiresAt DateTime? @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, slug])
  @@index([previewToken])
  @@map("cmsoffers")
}

model CmsPolicyDoc {
  id               String    @id @db.Char(24)
  key              String    @unique @db.VarChar(60)
  title            String    @db.VarChar(160)
  body             String    @db.LongText
  status           String    @default("DRAFT") @db.VarChar(20)
  version          Int       @default(1)
  publishedAt      DateTime? @db.DateTime(3)
  createdBy        String?   @db.Char(24)
  previewToken     String?   @db.VarChar(100)
  previewExpiresAt DateTime? @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([previewToken])
  @@map("cmspolicydocs")
}

model Media {
  id               String   @id @db.Char(24)
  fileName         String   @db.VarChar(255)
  url              String   @db.VarChar(500)
  storageKey       String   @unique @db.VarChar(255)
  storageProvider  String   @default("ftp") @db.VarChar(20)
  legacyUrl        String?  @db.VarChar(500)
  legacyStorageKey String?  @db.VarChar(255)
  mime             String   @db.VarChar(100)
  kind             String   @default("image") @db.VarChar(20)
  folder           String?  @db.VarChar(200)
  width            Int?
  height           Int?
  durationSec      Float?
  alt              String?  @db.VarChar(200)
  caption          String?  @db.VarChar(300)
  size             Int
  position         Int      @default(0)
  createdBy        String?  @db.Char(24)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([folder, createdAt])
  @@index([folder, position])
  @@map("media")
}

model EmailTemplate {
  id        String   @id @default(cuid()) @db.VarChar(36)
  key       String   @unique @db.VarChar(60)
  subject   String   @db.VarChar(160)
  htmlBody  String   @db.LongText
  textBody  String   @db.MediumText
  isEnabled Boolean  @default(true)
  updatedBy String?  @db.Char(24)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("emailtemplates")
}

model Enquiry {
  id               String   @id @db.Char(24)
  title            String?  @db.VarChar(20)
  firstName        String   @db.VarChar(80)
  lastName         String   @db.VarChar(80)
  email            String   @db.VarChar(160)
  telephone        String   @db.VarChar(40)
  holidayBudget    String?  @db.VarChar(60)
  partySize        Int?
  bedrooms         Int?
  fromDate         String?  @db.VarChar(30)
  toDate           String?  @db.VarChar(30)
  specificLocation String?  @db.VarChar(200)
  dogFriendly      Boolean?
  details          String?  @db.Text
  roomTypeId       String?  @db.Char(24)
  status           String   @default("NEW") @db.VarChar(20)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)

  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("enquiries")
}

model NewsletterSubscriber {
  id               String   @id @db.Char(24)
  email            String   @db.VarChar(160)
  normalizedEmail  String   @unique @db.VarChar(160)
  name             String?  @db.VarChar(120)
  source           String?  @db.VarChar(40)
  status           String   @default("SUBSCRIBED") @db.VarChar(20)
  unsubscribeToken String   @db.VarChar(64)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)

  @@index([status, createdAt])
  @@map("newslettersubscribers")
}

model Notification {
  id                String    @id @db.Char(24)
  type              String    @db.VarChar(60)
  recipient         String    @db.VarChar(160)
  bookingId         String?   @db.Char(24)
  paymentId         String?   @db.Char(24)
  idempotencyKey    String    @unique @db.VarChar(120)
  status            String    @default("QUEUED") @db.VarChar(20)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  nextAttemptAt     DateTime? @db.DateTime(3)
  lastError         String?   @db.Text
  provider          String?   @db.VarChar(40)
  providerMessageId String?   @db.VarChar(120)
  sentAt            DateTime? @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([bookingId, createdAt])
  @@map("notifications")
}

model Review {
  id             String    @id @db.Char(24)
  roomTypeId     String?   @db.Char(24)
  userId         String?   @db.Char(24)
  bookingId      String?   @db.Char(24)
  authorName     String    @db.VarChar(120)
  rating         Int
  title          String?   @db.VarChar(160)
  body           String    @db.Text
  stayDate       String?   @db.VarChar(30)
  isVerified     Boolean   @default(false)
  isAdminCreated Boolean   @default(false)
  status         String    @default("PENDING") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([roomTypeId, status, createdAt])
  @@index([bookingId])
  @@map("reviews")
}

model SiteSettings {
  id                  String   @id @db.Char(24)
  key                 String   @unique @default("site") @db.VarChar(40)
  propertyName        String   @default("Reservation") @db.VarChar(120)
  logoMediaId         String?  @db.Char(24)
  faviconMediaId      String?  @db.Char(24)
  phone               String?  @db.VarChar(40)
  supportEmail        String?  @db.VarChar(160)
  address             String?  @db.VarChar(300)
  timezone            String   @default("Asia/Kolkata") @db.VarChar(60)
  currency            String   @default("INR") @db.VarChar(10)
  checkInTime         String?  @db.VarChar(10)
  checkOutTime        String?  @db.VarChar(10)
  reminderHoursBefore Int      @default(24)
  social              Json?
  defaultSeo          Json?
  whyBookWithUs       Json?
  updatedAt           DateTime @updatedAt @db.DateTime(3)

  @@map("sitesettings")
}

model AuditLog {
  id         String   @id @db.Char(24)
  actorId    String?  @db.Char(24)
  actorRole  String?  @db.VarChar(40)
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(60)
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?  @db.VarChar(60)
  userAgent  String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("auditlogs")
}
