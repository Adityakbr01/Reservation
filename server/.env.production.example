# Production env for GoDaddy (Node-only host). cPanel me "Setup Node.js App"
# kholkar Application root select karein aur ye variables wahan ke
# Environment variables section me set karein (file upload karne ke bajaye,
# cPanel UI se set karna zyada safe hai). Secret values kabhi git me na dalein.

NODE_ENV=production
# cPanel/Passenger PORT inject karta hai; diya gaya port use hoga,
# warna 5000. Is line ko waise bhi set rakhein.
PORT=5000

# MongoDB Atlas (GoDaddy shared par local Mongo nahi milta).
# Atlas > Network Access me "Allow from anywhere (0.0.0.0/0)" enable karein
# ya GoDaddy server ka outbound IP whitelist karein.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/reservation?retryWrites=true&w=majority

# Kam se kam 32 random characters. Kabhi dev fallback ya localhost secret use na karein.
JWT_SECRET=CHANGE-ME-min-32-random-characters
JWT_EXPIRES_IN=7d

# Frontend alag deploy honge (Vite apps), isliye yahan unke asli URLs likhein
# (trailing slash nahi). Dono domains API ko call karenge to CORS me allow honge.
CLIENT_URL=https://book.hamptworthstays.com
ADMIN_URL=https://admin.hamptworthstays.com
# Agar aur domains/subdomains hon to comma-separated yahan:
EXTRA_ORIGINS=https://hamptworthstays.com

# GoDaddy proxy ke peeche hone ki wajah se hamesha true rakhein.
TRUST_PROXY=true

CACHE_TTL_SECONDS=900
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# Stripe LIVE keys (test keys production me kaam nahi karengi).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL Stripe dashboard me: https://yourdomain.com/api/v1/webhooks/stripe
# NOTE: server ko restart kiye bina webhook secret change na karein.

RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_REPLY_TO=no-reply@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com
# Optional absolute https logo for the email header (host logo.webp on the
# booking site or ImageKit). Unset keeps the text lockup.
# EMAIL_LOGO_URL=https://book.hamptworthstays.com/logo.webp

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Binary assets on GoDaddy (see migrate-imagekit-to-godaddy.md). Cut over by
# setting STORAGE_PROVIDER=ftp with the scoped FTP account below. Secrets only
# via the cPanel "Setup Node.js App" environment section — never in git.
STORAGE_PROVIDER=imagekit
GODADDY_FTP_HOST=
GODADDY_FTP_PORT=21
GODADDY_FTP_USER=
GODADDY_FTP_PASSWORD=
GODADDY_FTP_SECURE=true
GODADDY_FTP_PREFIX=
# Base = public URL of the FTP jail root (point the FTP account directory at the
# domain-root uploads/ folder in cPanel; keys carry no prefix).
ASSETS_BASE_URL=https://hamptworthstays.com/uploads

# Admin panel me login ka koi registration page nahi hai — pehla staff admin
# boot par isi se banta hai (email pehle se ho to skip). Deploy ke baad
# password zaroor badlein.
ADMIN_NAME=Administrator
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=CHANGE-ME-min-8-chars

# ── Frontend builds (client/ aur admin/ me `vite build` se pehle set karein) ──
# client/.env.production me:  VITE_API_URL=https://api.yourdomain.com/api/v1
# admin/.env.production me:   VITE_API_URL=https://api.yourdomain.com/api/v1
# (API ka domain wahi jo is server ke cPanel app par mapped hai.)
