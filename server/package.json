    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "resend": "^6.32.0",
    "stripe": "^23.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "bun-types": "^1.4.2",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "bson": "7.2.0"
  }
