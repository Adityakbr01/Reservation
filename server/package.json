{
  "name": "reservation-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "dev:node": "node --watch dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild-node.cjs",
    "deploy:zip": "npm run build && node scripts/pack-deploy.cjs",
    "start": "node dist/server.js",
    "start:bun": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "bun test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "resend": "^6.32.0",
    "stripe": "^23.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "archiver": "^8.0.0",
    "bun-types": "^1.4.2",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "bson": "7.2.0"
  }
}
